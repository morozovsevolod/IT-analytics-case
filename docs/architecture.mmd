flowchart LR
    subgraph Ext["Внешние источники"]
        A1["API авиакомпаний"]
        A2["API отелей и букинга"]
        A3["Партнёрские фиды / скрапинг"]
    end

    subgraph Ing["Приём данных"]
        P1["Воркеры опроса"]
        P2["Приёмник вебхуков"]
        NORM["Нормализатор → каноническое событие"]
        OUTBOX["Outbox / журнал событий"]
    end

    subgraph Bus["Шина событий"]
        EB["Долговечный поток событий"]
    end

    subgraph Cons["Потребители"]
        OP["Операционный потребитель"]
        IX["Потребитель индекса"]
        NOTIF["Маршрутизатор уведомлений"]
        REB["Оркестратор перебронирования"]
        CV["Валидатор ограничений<br/>багаж / визы / таймзоны / группа"]
    end

    subgraph Data["Хранилища"]
        OPST["Операционное хранилище поездок"]
        IDX["Поисковый индекс"]
        REV["Обратный индекс<br/>рейс → поездки"]
        VAULT["Хранилище паспортных данных"]
        INBOX["Долговечный офлайн-инбокс"]
    end

    subgraph Clients["Клиенты"]
        APP["Мобильное приложение / веб"]
        SMS["SMS / Email"]
    end

    A1 --> P1
    A2 --> P1
