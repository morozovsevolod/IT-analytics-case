flowchart LR
    subgraph Allowed["Разрешённый путь доступа"]
        TC["TripContext"] --> REF["passengerProfileRef"]
        REF --> REB["Оркестратор перебронирования"]
        REB --> JIT["Извлечение точно в момент вызова"]
        JIT --> VAULT["Хранилище паспортных данных<br/>шифрование + аудит"]
        VAULT --> PROV["Вызов API провайдера"]
    end

    subgraph Forbidden["Никогда не содержит паспортных данных"]
        F1["Поток событий"]
        F2["Поисковый индекс"]
        F3["Логи / трейсы / аналитика"]
        F4["PDF / уведомления"]
        F5["Офлайн-инбокс"]
    end

    VAULT --> LIFE["Удаление или анонимизация<br/>после поездки и окна обслуживания"]
